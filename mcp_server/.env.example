# Optional process-level overrides; all ordinary settings are in config.json.
# The server automatically loads config.json and its ignored config.local.json overlay.
# MCP_CONFIG_FILE=/absolute/path/to/config.json
# MCP_AUTH_TOKEN=your-existing-token
# MCP_TERMINAL_IDLE_TTL_MS=300000
# MCP_TERMINAL_GC_INTERVAL_MS=30000
